{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "veloce-frontend": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "veloce",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/veloce-frontend",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.json",
            "inlineStyleLanguage": "scss",
            "assets": ["src/assets"],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "production": { "budgets": [{ "type": "initial", "maximumWarning": "700kb", "maximumError": "1mb" }], "outputHashing": "all" },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular-devkit/build-angular:dev-server", "configurations": { "production": { "buildTarget": "veloce-frontend:build:production" }, "development": { "buildTarget": "veloce-frontend:build:development" } }, "defaultConfiguration": "development" },
        "test": { "builder": "@angular-devkit/build-angular:karma", "options": { "polyfills": ["zone.js", "zone.js/testing"], "tsConfig": "tsconfig.spec.json", "inlineStyleLanguage": "scss", "karmaConfig": "karma.conf.js", "assets": ["src/assets"], "styles": ["src/styles.scss"] } }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
